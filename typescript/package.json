{
  "name": "@apexguard/sdk",
  "version": "0.1.1",
  "description": "Runtime security middleware for LLM agents — prompt injection, tool misuse, and memory poisoning defense",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./adapters/vercel-ai": {
      "import": "./dist/adapters/vercel-ai.js",
      "types": "./dist/adapters/vercel-ai.d.ts"
    },
    "./adapters/openai-agents": {
      "import": "./dist/adapters/openai-agents.js",
      "types": "./dist/adapters/openai-agents.d.ts"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "dev": "tsc --watch"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.0.0",
    "typescript": "^7.0.2"
  },
  "keywords": ["llm", "security", "agent", "prompt-injection", "ai-safety"],
  "repository": {
    "type": "git",
    "url": "https://github.com/kshkrao3/agentshield"
  }
}
